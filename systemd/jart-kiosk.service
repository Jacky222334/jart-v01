[Unit]
Description=jart Pi Kiosk (GPIO-TFT 3.5 · Sound · 90 Grad links)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/jbs3123/.Xauthority
Environment=HOME=/home/jbs3123
ExecStartPre=/bin/sleep 20
ExecStartPre=/bin/bash -c 'for i in $(seq 1 45); do xdpyinfo -display :0 >/dev/null 2>&1 && exit 0; sleep 2; done; exit 0'
ExecStart=/home/jbs3123/start-jart-kiosk.sh run
ExecStop=/home/jbs3123/start-jart-kiosk.sh stop
Restart=always
RestartSec=10
TimeoutStartSec=240

[Install]
WantedBy=default.target
